# Jira 서버 주소 (끝에 슬래시 없이)
JIRA_BASE_URL=https://jira.yourcompany.com

# Jira 로그인 정보
JIRA_USERNAME=your.email@company.com
JIRA_PASSWORD=your_password

# JQL에 들어갈 담당자 ID (Jira 로그인 username)
JIRA_ASSIGNEE=your_jira_username

# JQL 프로젝트명 (띄어쓰기 포함 시 큰따옴표로 감싸짐)
JIRA_PROJECT=KI_R&D-KONA CARD Platform

# 폴링 주기 (밀리초, 기본 2분)
JIRA_POLL_INTERVAL=120000

# 회사 프록시 SSL 인증서 경로 (필요 없으면 비워두기)
CERT_PATH=
