# SSL 인증서 경로 (회사 프록시 환경에서만 필요)
# 설정하면 ios-watcher.js와 server.js에서 NODE_EXTRA_CA_CERTS로 자동 적용됩니다.
# CERT_PATH=/path/to/your/proxy.crt

# Anthropic API 키 (Settings > 컴포넌트 매핑의 화면 자동 요약 기능에 필요)
# ANTHROPIC_API_KEY=sk-ant-...

# 사내 위키 (Confluence) 인증
# API 명세 첨부 시 위키 URL을 입력하면 자동으로 내용을 가져옵니다.
# WIKI_USERNAME=your-email@company.com
# WIKI_PASSWORD=your-password
